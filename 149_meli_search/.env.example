# Copy file này thành .env rồi sửa lại giá trị.
#   cp .env.example .env          (Git Bash / macOS / Linux)
#   copy .env.example .env        (CMD)
#
# docker compose đọc .env để thay biến trong docker-compose.yml,
# còn ứng dụng Node đọc cùng file đó qua process.loadEnvFile() trong src/config.js.
# Biến đã có sẵn trong môi trường luôn thắng giá trị trong .env (Node không ghi đè).

# Master key của Meilisearch. Tối thiểu 16 byte khi MEILI_ENV=production.
# Sinh khoá mới: openssl rand -base64 32
MEILI_MASTER_KEY=MASTER_KEY_DEMO_DOI_TRUOC_KHI_LEN_PROD

# development: bật giao diện search preview ở http://localhost:7700, master key không bắt buộc.
# production : tắt giao diện đó, bắt buộc có master key >= 16 byte.
MEILI_ENV=development

# Địa chỉ Meilisearch mà app Node gọi tới.
#   chạy app trên máy      -> http://localhost:7700
#   chạy app trong compose -> http://meilisearch:7700 (đã set sẵn trong docker-compose.yml)
MEILI_HOST=http://localhost:7700

# Khoá mà app dùng để gọi API. Để trống thì src/config.js tự lấy MEILI_MASTER_KEY.
# Trên production KHÔNG dùng master key ở đây, hãy tạo API key riêng: npm run keys
MEILI_API_KEY=

# Tên index dùng trong ví dụ.
MEILI_INDEX=products

# ERROR | WARN | INFO | DEBUG | TRACE. Mặc định của Meilisearch là INFO, ghi một dòng cho
# mỗi request HTTP nên rất nhiễu khi chạy "docker compose up". Ví dụ đặt WARN cho dễ đọc.
MEILI_LOG_LEVEL=WARN
