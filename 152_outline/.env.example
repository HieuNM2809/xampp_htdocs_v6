# Copy file này thành .env rồi sửa lại giá trị:
#   cp .env.example .env               (Git Bash / macOS / Linux)
#   Copy-Item .env.example .env        (PowerShell)
#
# File .env được dùng cho HAI việc:
#   1. docker compose tự đọc .env cùng thư mục để thay các biến ${...} trong docker-compose.yml
#      (phiên bản image, cổng mở ra máy host, user/mật khẩu PostgreSQL).
#   2. Dòng "env_file: .env" của service outline nạp TOÀN BỘ file này làm biến môi trường của Outline.
#
# Trước lần chạy đầu BẮT BUỘC sinh SECRET_KEY và UTILS_SECRET (mục "Khoá bí mật" bên dưới). Các giá trị
# còn lại chạy được ngay trên máy cá nhân.
#
# Sửa .env khi Outline đang chạy: chạy lại "docker compose up -d" ("restart" KHÔNG nạp lại env_file).
# Không commit .env (đã có trong .gitignore) và cất một bản ở nơi an toàn: mất SECRET_KEY là mất khả năng
# đọc dữ liệu đã mã hoá trong database.
# Danh sách đầy đủ biến của Outline: https://github.com/outline/outline/blob/main/.env.sample

# ---------------------------------------------------------------------------------------------
# Docker Compose: phiên bản image, cổng mở ra máy host
# ---------------------------------------------------------------------------------------------
# Ghim phiên bản để tự quyết định lúc nâng cấp (README mục 7.4). Danh sách bản phát hành:
# https://github.com/outline/outline/releases
OUTLINE_VERSION=1.13.0

# Cổng trên máy host, trỏ vào cổng 3000 trong container Outline. Cố ý tránh 3000: máy dev Node thường đã có
# app khác chiếm cổng đó, và Docker Desktop trên Windows có thể lặng lẽ bỏ qua việc mở cổng.
# Đổi cổng thì sửa CẢ URL bên dưới VÀ redirectURIs trong dex/config.yaml.
OUTLINE_PORT=3500

# Trang đăng nhập của Dex. Đổi thì sửa issuer trong dex/config.yaml và OIDC_AUTH_URI bên dưới.
DEX_PORT=5556

# Giao diện web của Mailpit: xem các email Outline gửi.
MAILPIT_PORT=8025

# ---------------------------------------------------------------------------------------------
# Ứng dụng
# ---------------------------------------------------------------------------------------------
NODE_ENV=production

# Địa chỉ ĐẦY ĐỦ người dùng gõ trên trình duyệt: có http/https, có cổng nếu khác 80/443, không có "/" cuối.
# Outline dùng nó để tạo link trong email, callback đăng nhập (URL/auth/oidc.callback) và WebSocket.
# Phải khớp chính xác: URL là http://localhost:3500 mà mở bằng http://127.0.0.1:3500 thì đăng nhập lỗi.
URL=http://localhost:3500

# Cổng Outline nghe BÊN TRONG container. Giữ 3000; cổng phía máy host là OUTLINE_PORT ở trên.
PORT=3000

# Chạy http (không TLS) thì PHẢI là false, nếu không Outline chuyển hướng sang https:// và không vào được.
# Production đứng sau reverse proxy có HTTPS: đặt true (README mục 13).
FORCE_HTTPS=false

# Ngôn ngữ giao diện mặc định cho user mới. Có vi_VN (đã dịch khoảng 60%, phần còn lại vẫn tiếng Anh);
# mỗi người tự đổi ở Settings → Preferences → Language.
DEFAULT_LANGUAGE=en_US

# Số process web. Ước lượng: RAM trống của máy chủ (MB) / 512.
WEB_CONCURRENCY=1

# error | warn | info | http | verbose | debug | silly
LOG_LEVEL=info

# true: định kỳ gửi thống kê ẩn danh cho nhóm phát triển Outline để kiểm tra có bản mới hay không.
ENABLE_UPDATES=false

# ---------------------------------------------------------------------------------------------
# Khoá bí mật: BẮT BUỘC tự sinh, mỗi bản cài một giá trị riêng
# ---------------------------------------------------------------------------------------------
# SECRET_KEY   đúng 64 ký tự hex (32 byte ngẫu nhiên). Outline dùng để ký phiên đăng nhập và MÃ HOÁ một số
#              dữ liệu trong database. Đổi hoặc làm mất sau khi đã dùng: mọi người bị đăng xuất, dữ liệu đã
#              mã hoá không đọc lại được. Để trống thì Outline không khởi động (báo lỗi ngay trong log).
# UTILS_SECRET chuỗi ngẫu nhiên bất kỳ, bảo vệ endpoint nội bộ dùng để kích hoạt các tác vụ định kỳ.
#
# Sinh giá trị (chạy 2 lần, mỗi biến một giá trị khác nhau):
#   openssl rand -hex 32                                                        Git Bash / macOS / Linux
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"    máy có Node.js
#   PowerShell (5.1 và 7):
#   $b = [byte[]]::new(32); [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); -join ($b | ForEach-Object { $_.ToString('x2') })
SECRET_KEY=
UTILS_SECRET=

# ---------------------------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------------------------
# Container postgres tạo user + database theo 3 biến này ở LẦN CHẠY ĐẦU (volume postgres-data còn trống).
# Đổi sau đó không có tác dụng với database đã tạo: đổi mật khẩu bằng SQL, hoặc xoá volume làm lại từ đầu.
POSTGRES_USER=outline
POSTGRES_PASSWORD=doi-mat-khau-nay
POSTGRES_DB=outline

# Chuỗi kết nối Outline dùng: postgres://<user>:<mật khẩu>@<host>:<cổng>/<database>
# PHẢI khớp 3 biến POSTGRES_* ở trên. "postgres" là tên service trong docker-compose.yml.
# Mật khẩu có ký tự đặc biệt (@ : / ? # %) thì phải mã hoá URL, ví dụ @ thành %40.
DATABASE_URL=postgres://outline:doi-mat-khau-nay@postgres:5432/outline

# PostgreSQL chạy chung máy, không bật SSL. Thiếu dòng này thì Outline (NODE_ENV=production) đòi kết nối SSL
# và dừng với lỗi "The database does not support SSL connections".
PGSSLMODE=disable

# ---------------------------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------------------------
# Hàng đợi job (gửi email, xuất dữ liệu...), cache và đồng bộ realtime. "redis" là tên service.
REDIS_URL=redis://redis:6379

# ---------------------------------------------------------------------------------------------
# Lưu file đính kèm
# ---------------------------------------------------------------------------------------------
# local: lưu trên đĩa, trong volume outline-data (gắn vào /var/lib/outline/data). Mặc định của Outline là
# s3, nên PHẢI đặt local khi không dùng S3/MinIO.
FILE_STORAGE=local
FILE_STORAGE_LOCAL_ROOT_DIR=/var/lib/outline/data
# Dung lượng tối đa của mỗi file tải lên (byte). 262144000 = 250 MB.
FILE_STORAGE_UPLOAD_MAX_SIZE=262144000
#
# Dùng S3 / MinIO / Cloudflare R2 thay cho đĩa local (chạy nhiều máy chủ Outline thì bắt buộc):
# FILE_STORAGE=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-southeast-1
# AWS_S3_UPLOAD_BUCKET_URL=https://s3.ap-southeast-1.amazonaws.com
# AWS_S3_UPLOAD_BUCKET_NAME=outline-attachments
# AWS_S3_FORCE_PATH_STYLE=true
# AWS_S3_ACL=private

# ---------------------------------------------------------------------------------------------
# Đăng nhập: cần ÍT NHẤT MỘT phương thức. Outline không có kiểu đăng nhập user/mật khẩu riêng.
# ---------------------------------------------------------------------------------------------
# Callback (redirect URI) phải khai báo bên phía nhà cung cấp, dạng <URL>/auth/<tên>.callback:
#   OIDC       http://localhost:3500/auth/oidc.callback
#   Google     http://localhost:3500/auth/google.callback
#   Slack      https://<tên miền>/auth/slack.callback      (Slack chỉ nhận redirect https)
#   Microsoft  http://localhost:3500/auth/azure.callback
# Bật nhiều phương thức cùng lúc được; trang đăng nhập hiện một nút cho mỗi phương thức.

# ---- OIDC: mặc định của demo, Dex chạy trong docker-compose.yml (tài khoản ở dex/config.yaml) ----
# Client id/secret phải khớp staticClients trong dex/config.yaml.
OIDC_CLIENT_ID=outline
OIDC_CLIENT_SECRET=outline-dex-secret
# TRÌNH DUYỆT mở URL này, nên phải là địa chỉ nhìn từ máy host: localhost + cổng DEX_PORT.
OIDC_AUTH_URI=http://localhost:5556/dex/auth
# Hai URL này do SERVER Outline gọi từ TRONG container, nên dùng tên service "dex" (cổng 5556 của container).
# Viết localhost ở đây là sai: localhost trong container chính là container outline.
OIDC_TOKEN_URI=http://dex:5556/dex/token
OIDC_USERINFO_URI=http://dex:5556/dex/userinfo
# Chữ trên nút đăng nhập: "Continue with Dex".
OIDC_DISPLAY_NAME=Dex
OIDC_SCOPES=openid profile email
OIDC_USERNAME_CLAIM=preferred_username
# true: luôn hiện trang đăng nhập của Outline thay vì tự chuyển thẳng sang Dex khi OIDC là phương thức duy
# nhất. Đăng xuất xong vẫn chọn lại được tài khoản (tài liệu Outline khuyên đặt biến này hoặc OIDC_LOGOUT_URI).
OIDC_DISABLE_REDIRECT=true
#
# IdP thật có trang /.well-known/openid-configuration (Keycloak, Authentik, Authelia, GitLab...): chỉ cần
# OIDC_ISSUER_URL + client id/secret, Outline tự tìm các endpoint lúc khởi động. XOÁ 3 dòng OIDC_*_URI ở trên
# (còn đủ 3 dòng đó thì Outline dùng cấu hình thủ công, bỏ qua OIDC_ISSUER_URL).
# OIDC_ISSUER_URL=https://sso.example.com/realms/company
# OIDC_LOGOUT_URI=https://sso.example.com/realms/company/protocol/openid-connect/logout

# ---- Google (Google Workspace / Gmail) ----
# Google Cloud Console → APIs & Services → Credentials → Create OAuth client ID → Web application.
# Authorized redirect URI: <URL>/auth/google.callback (Google chấp nhận http://localhost khi chạy thử).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ---- Slack ----
# https://api.slack.com/apps → OAuth & Permissions → Redirect URLs: <URL>/auth/slack.callback
# Slack chỉ chấp nhận redirect https, nên cần tên miền có HTTPS (hoặc tunnel như ngrok, cloudflared).
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=

# ---- Microsoft Entra ID (Azure AD) ----
# Entra admin center → App registrations → New registration; Redirect URI (Web): <URL>/auth/azure.callback
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_RESOURCE_APP_ID=

# Discord và các phương thức khác: xem .env.sample của Outline (link ở đầu file).

# ---------------------------------------------------------------------------------------------
# Email (SMTP): lời mời, thông báo, link/mã đăng nhập gửi qua email
# ---------------------------------------------------------------------------------------------
# Demo gửi vào Mailpit (service "mailpit"): không email nào ra Internet, xem tại http://localhost:8025.
# Có SMTP thì trang đăng nhập có thêm ô Email (đăng nhập bằng link gửi qua email), bật/tắt ở
# Settings → Authentication.
SMTP_HOST=mailpit
SMTP_PORT=1025
# Mailpit không dùng TLS. Mặc định của Outline là true (bắt tay TLS ngay, kiểu cổng 465), nên phải đặt false.
SMTP_SECURE=false
SMTP_FROM_EMAIL=outline@example.com
#
# Dịch vụ email có sẵn trong nodemailer (Gmail, SendGrid, Mailgun, SES...): XOÁ SMTP_HOST/SMTP_PORT ở trên.
# Gmail / Google Workspace cần App Password, không dùng mật khẩu đăng nhập.
# SMTP_SERVICE=Gmail
# SMTP_USERNAME=wiki@congty.vn
# SMTP_PASSWORD=<app-password>
# SMTP_FROM_EMAIL=wiki@congty.vn
#
# Mail server riêng của công ty:
# SMTP_HOST=smtp.congty.vn
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USERNAME=wiki@congty.vn
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=wiki@congty.vn

# ---------------------------------------------------------------------------------------------
# Tuỳ chọn khác
# ---------------------------------------------------------------------------------------------
# Ghi log từng request HTTP (nhiều dòng, chỉ bật khi điều tra lỗi):
# DEBUG=http
#
# Giới hạn số request (bật sẵn; mặc định tối đa 1000 request mỗi 60 giây cho một IP hoặc một user):
# RATE_LIMITER_ENABLED=true
# RATE_LIMITER_REQUESTS=1000
# RATE_LIMITER_DURATION_WINDOW=60
