# Copy file này thành .env rồi sửa lại giá trị:
#   cp .env.example .env               (Git Bash / macOS / Linux)
#   Copy-Item .env.example .env        (PowerShell)
#
# docker compose tự đọc .env cùng thư mục để thay các biến ${...} trong docker-compose*.yml.
# Không có .env thì dùng giá trị mặc định ghi sẵn trong các file compose, demo vẫn chạy được.
# Biến đang có trong shell sẽ THẮNG giá trị trong .env.

# ---------------------------------------------------------------------------------------------
# Cổng mở ra máy host
# ---------------------------------------------------------------------------------------------
# Cố ý tránh 3000: máy dev Node thường đã có app khác chiếm cổng đó, và Docker Desktop trên Windows
# có thể KHÔNG báo lỗi mà chỉ lặng lẽ bỏ qua việc mở cổng (docker compose ps chỉ hiện "3400/tcp").
ORDER_SERVICE_PORT=3400
PAYMENT_SERVICE_PORT=3401

# ---------------------------------------------------------------------------------------------
# Ứng dụng
# ---------------------------------------------------------------------------------------------
# trace | debug | info | warn | error
LOG_LEVEL=info

# Tỉ lệ (0..1) payment-service giả lập "cổng ngân hàng không phản hồi" → order-service trả 502.
# Đặt 0 để tắt lỗi ngẫu nhiên, đặt 0.5 để thấy nhiều error trace hơn.
PAYMENT_FAILURE_RATE=1

# ---------------------------------------------------------------------------------------------
# OpenTelemetry: thuộc tính chung, ghép thành OTEL_RESOURCE_ATTRIBUTES trong file compose
# ---------------------------------------------------------------------------------------------
SERVICE_VERSION=1.0.0
# SigNoz dùng deployment.environment cho bộ lọc Environment ở đầu trang Services.
DEPLOYMENT_ENVIRONMENT=docker-demo

# Log nội bộ của OpenTelemetry SDK: none | error | warn | info | debug | verbose | all
# warn: chỉ báo khi gửi dữ liệu thất bại. Đổi sang debug khi điều tra "không thấy dữ liệu".
OTEL_LOG_LEVEL=warn

# Chu kỳ đẩy metric (ms). SDK mặc định 60000; demo để 15000 cho nhanh thấy số liệu.
OTEL_METRIC_EXPORT_INTERVAL=15000

# ---------------------------------------------------------------------------------------------
# Cách A: app chung network Docker với SigNoz self-host  (docker-compose.yml)
# ---------------------------------------------------------------------------------------------
# SigNoz cài bằng Foundry (cách chính thức hiện nay):
SIGNOZ_NETWORK=signoz-network
SIGNOZ_OTLP_ENDPOINT=http://signoz-ingester:4318
#
# SigNoz cài bằng docker compose cũ trong repo SigNoz (deploy/docker, bản <= v0.129.0):
# SIGNOZ_NETWORK=signoz-net
# SIGNOZ_OTLP_ENDPOINT=http://otel-collector:4318

# ---------------------------------------------------------------------------------------------
# Cách B: SigNoz chạy riêng / ở máy khác / SigNoz Cloud  (docker-compose.standalone.yml)
# ---------------------------------------------------------------------------------------------
# SigNoz trên chính máy này, đi qua cổng 4318 đã mở ra host:
OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:4318
OTEL_EXPORTER_OTLP_HEADERS=
#
# SigNoz ở máy khác trong mạng LAN:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://192.168.1.50:4318
#
# SigNoz Cloud (region: us | eu | in ..., xem Settings → Ingestion trong SigNoz Cloud):
# OTEL_EXPORTER_OTLP_ENDPOINT=https://ingest.<region>.signoz.cloud:443
# OTEL_EXPORTER_OTLP_HEADERS=signoz-ingestion-key=<your-ingestion-key>
